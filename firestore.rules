rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      let rolePath = /databases/$(database)/documents/userRoles/$(request.auth.uid);
      return exists(rolePath) ? get(rolePath).data.role : null;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function hasAnyRole(roles) {
      return isAuthenticated() && getUserRole() in roles;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function getSupervisorDepartment() {
      return 'PRODUCTION';
    }


    // ============================================================
    // userRoles - Role assignments (sensitive)
    // Single-doc reads: user's own doc only
    // Collection queries: admins only (approvals page, admin users page)
    // Writes: Firebase Admin SDK only (server-side)
    // ============================================================
    match /userRoles/{userId} {
      allow get: if isAuthenticated() && request.auth.uid == userId;
      allow list: if isAuthenticated() && isAdmin();
      allow write: if false; // Managed by Firebase Admin SDK only
    }


    // ============================================================
    // employees - Staff directory
    // All authenticated users can read
    // Create/Edit: ADMIN or PRODUCTION_SUPERVISOR (own department only).
    // Users who can access the Employees page may make status-only updates
    // within the employee scope visible to their role.
    // Delete: ADMIN only
    // ============================================================
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (hasRole('PRODUCTION_SUPERVISOR') && request.resource.data.department == getSupervisorDepartment());
      allow update: if isAdmin()
        || (hasRole('PRODUCTION_SUPERVISOR') && resource.data.department == getSupervisorDepartment() && request.resource.data.department == resource.data.department)
        || (hasRole('FINANCIAL_MANAGER') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payeApplicable']))
        || (hasAnyRole(['FINANCIAL_MANAGER', 'SALES_MANAGER'])
          && (hasRole('FINANCIAL_MANAGER') || resource.data.department == 'SALES')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'statusChangedAt', 'statusChangedBy'])
          && request.resource.data.isActive is bool
          && request.resource.data.statusChangedAt is timestamp
          && request.resource.data.statusChangedBy == request.auth.uid);
      allow delete: if isAdmin();
    }


    // ============================================================
    // workers - Secondary worker list for target assignment
    // All authenticated users can read; only admins write
    // ============================================================
    match /workers/{workerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // productionStages - Stage definitions & default targets
    // All authenticated users can read; only admins write
    // ============================================================
    match /productionStages/{stageId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);
    }


    // ============================================================
    // targetConfigs - Per-worker daily target overrides
    // All authenticated users can read; only admins write
    // ============================================================
    match /targetConfigs/{configId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);
    }


    // ============================================================
    // productionEntries - Daily production records
    // All authenticated users can read
    // Create: PRODUCTION_SUPERVISOR or ADMIN
    // Update: ADMIN or PRODUCTION_SUPERVISOR (paymentStatus/paymentId only)
    // Delete: ADMIN only
    // ============================================================
    match /productionEntries/{entryId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);
      allow update: if isAdmin() || (hasRole('PRODUCTION_SUPERVISOR') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentId']));
      allow delete: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);
    }


    // ============================================================
    // batches - Production batch lifecycle
    // All authenticated users can read
    // Create/Update: ADMIN, PRODUCTION_SUPERVISOR, FINANCIAL_MANAGER, SALES_MANAGER, SALES_STAFF
    // Delete: ADMIN only
    // ============================================================
    match /batches/{batchId} {
      allow read: if isAuthenticated();
      allow create, update: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR', 'FINANCIAL_MANAGER', 'SALES_MANAGER', 'SALES_STAFF']);
      allow delete: if isAdmin();
    }


    // ============================================================
    // counters - Sequential counters (e.g. batch numbering)
    // All authenticated users can read
    // Write: PRODUCTION_SUPERVISOR or ADMIN (for batch number generation)
    // ============================================================
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);
    }


    // ============================================================
    // payments - Payment records & receipts
    // All authenticated users can read
    // Create: ADMIN or PRODUCTION_SUPERVISOR (via Pay Due flow)
    // No update/delete (immutable once created)
    // ============================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);
      allow update, delete: if false;
    }

    // PAYE schedule is shared by payroll and editable by finance/admin only.
    match /payeSettings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update: if settingId == 'current' && hasAnyRole(['ADMIN', 'FINANCIAL_MANAGER']);
      allow delete: if false;
    }

    // PAYE remittances are immutable tax-liability settlements. The balance
    // control document is updated in the same transaction to prevent overpayment.
    match /payeRemittances/{remittanceId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['ADMIN', 'FINANCIAL_MANAGER'])
        && request.resource.data.keys().hasOnly(['paymentDate', 'returnPeriod', 'amount', 'paymentSourceCode', 'uraReference', 'notes', 'createdBy', 'createdAt'])
        && request.resource.data.paymentDate is string
        && request.resource.data.returnPeriod is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.paymentSourceCode in ['1000', '1030']
        && request.resource.data.uraReference is string
        && request.resource.data.uraReference.size() > 0
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /payeLiabilityBalances/{balanceId} {
      allow read: if isAuthenticated();
      allow create, update: if balanceId.matches('^[0-9]{4}-[0-9]{2}$') && hasAnyRole(['ADMIN', 'FINANCIAL_MANAGER'])
        && request.resource.data.keys().hasOnly(['totalRemitted', 'updatedAt', 'updatedBy'])
        && request.resource.data.totalRemitted is number
        && request.resource.data.totalRemitted >= 0
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }


    // ============================================================
    // stockIns - Stock received into inventory
    // All authenticated users can read
    // Create: ADMIN, STORE_MANAGER, or PRODUCTION_SUPERVISOR
    // Update/Delete: ADMIN only
    // ============================================================
    match /stockIns/{stockInId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['ADMIN', 'STORE_MANAGER', 'PRODUCTION_SUPERVISOR']);
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // stockOuts - Stock dispatched from inventory
    // All authenticated users can read
    // Create: STORE_MANAGER or ADMIN or PRODUCTION_SUPERVISOR
    // Update/Delete: ADMIN only
    // ============================================================
    match /stockOuts/{stockOutId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['ADMIN', 'STORE_MANAGER', 'PRODUCTION_SUPERVISOR']);
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // saleTransactions - Sales records
    // All authenticated users can read
    // Create: SALES_STAFF or ADMIN
    // Update/Delete: ADMIN only
    // ============================================================
    match /saleTransactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['ADMIN', 'SALES_STAFF', 'FINANCIAL_MANAGER', 'SALES_MANAGER']);
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // salesTargets - Sales target goals (monthly/quarterly/annual)
    // All authenticated users can read
    // Create: SALES_STAFF or ADMIN
    // Update/Delete: ADMIN only
    // ============================================================
    match /salesTargets/{targetId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['ADMIN', 'SALES_STAFF', 'FINANCIAL_MANAGER', 'SALES_MANAGER']);
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // expenses - Business expense records
    // All authenticated users can read
    // Create: FINANCE or ADMIN
    // Update/Delete: ADMIN only
    // ============================================================
    function validBankingJournal(data, journalId) {
      return !data.keys().hasAny(['bankingKind'])
        || (data.bankingKind == 'deposit'
          && data.debitCode == '1000'
          && !(data.creditCode in ['1000', '1010', '1020', '1030'])
          && data.get('bankingStatus', '') == 'completed'
          && data.get('receivedFrom', '') is string
          && data.get('receivedFrom', '').size() > 0
          && data.get('paymentMethod', '') in ['Cash', 'Cheque']
          && (data.get('paymentMethod', '') != 'Cheque' || data.get('referenceNumber', '').size() > 0))
        || (data.bankingKind == 'transfer'
          && ((data.debitCode == '1000'
              && data.creditCode in ['1010', '1020', '1030']
              && data.get('bankingLinkId', '') == journalId
              && data.get('bankingStatus', '') in ['awaiting_deposit_details', 'completed']
              && (data.get('bankingStatus', '') != 'completed' || data.get('receivedFrom', '').size() > 0))
            || (data.creditCode == '1000'
              && data.debitCode in ['1010', '1020', '1030']
              && data.get('bankingStatus', '') == 'completed')));
    }

    match /accountJournals/{journalId} {
      allow read: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER', 'SALES_MANAGER', 'SALES_STAFF']);
      allow create: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.debitCode is string && request.resource.data.creditCode is string
        && request.resource.data.debitCode != request.resource.data.creditCode
        && request.resource.data.date is string && request.resource.data.description is string
        && (!request.resource.data.keys().hasAny(['simplifiedCategory'])
          || request.resource.data.simplifiedCategory in ['Assets', 'Liabilities', 'Equity'])
        && validBankingJournal(request.resource.data, journalId);
      allow update: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'debitCode', 'creditCode', 'amount', 'description', 'simplifiedCategory', 'simplifiedItemCode', 'simplifiedOffsetCode', 'bankingStatus', 'receivedFrom', 'paymentMethod', 'referenceNumber'])
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.debitCode is string && request.resource.data.creditCode is string
        && request.resource.data.debitCode != request.resource.data.creditCode
        && request.resource.data.date is string && request.resource.data.description is string
        && (!request.resource.data.keys().hasAny(['simplifiedCategory'])
          || request.resource.data.simplifiedCategory in ['Assets', 'Liabilities', 'Equity'])
        && request.resource.data.get('bankingKind', '') == resource.data.get('bankingKind', '')
        && (resource.data.get('bankingKind', '') != 'transfer'
          || (request.resource.data.debitCode == resource.data.debitCode && request.resource.data.creditCode == resource.data.creditCode))
        && validBankingJournal(request.resource.data, journalId);
      allow delete: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER']);
    }
    match /productionCosts/{costId} {
      allow read: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER', 'SALES_MANAGER', 'SALES_STAFF']);
      allow create: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.description is string && request.resource.data.description.size() > 0
        && request.resource.data.item in ['purchases_raw_materials', 'carriage_inwards', 'other_costs']
        && request.resource.data.settlementCode in ['1000', '1030'];
      allow update: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'item', 'description', 'amount', 'settlementCode', 'reference', 'notes'])
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.description is string && request.resource.data.description.size() > 0
        && request.resource.data.item in ['purchases_raw_materials', 'carriage_inwards', 'other_costs']
        && request.resource.data.settlementCode in ['1000', '1030'];
      allow delete: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER']);
    }
    match /taxEntries/{taxId} {
      allow read: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER', 'SALES_MANAGER', 'SALES_STAFF']);
      allow create: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.description is string
        && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow update: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'description', 'amount'])
        && request.resource.data.date is string
        && request.resource.data.description is string
        && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow delete: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER']);
    }
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER']);
      allow update, delete: if isAdmin();
    }
  }
}
