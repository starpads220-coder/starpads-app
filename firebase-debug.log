[debug] [2026-10-01T20:18:16.901Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/starpads-automation/rulesets {"name":"projects/starpads-automation/rulesets/34b55f2b-4fbf-43d9-b64e-f30f1cb10e00","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // ============================================================\r\n    // HELPER FUNCTIONS\r\n    // ============================================================\r\n\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function getUserRole() {\r\n      let rolePath = /databases/$(database)/documents/userRoles/$(request.auth.uid);\r\n      return exists(rolePath) ? get(rolePath).data.role : null;\r\n    }\r\n\r\n    function hasRole(role) {\r\n      return isAuthenticated() && getUserRole() == role;\r\n    }\r\n\r\n    function hasAnyRole(roles) {\r\n      return isAuthenticated() && getUserRole() in roles;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return hasRole('ADMIN');\r\n    }\r\n\r\n    function getSupervisorDepartment() {\r\n      return 'PRODUCTION';\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // userRoles - Role assignments (sensitive)\r\n    // Single-doc reads: user's own doc only\r\n    // Collection queries: admins only (approvals page, admin users page)\r\n    // Writes: Firebase Admin SDK only (server-side)\r\n    // ============================================================\r\n    match /userRoles/{userId} {\r\n      allow get: if isAuthenticated() && request.auth.uid == userId;\r\n      allow list: if isAuthenticated() && isAdmin();\r\n      allow write: if false; // Managed by Firebase Admin SDK only\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // employees - Staff directory\r\n    // All authenticated users can read\r\n    // Create/Update: ADMIN or PRODUCTION_SUPERVISOR (own department only)\r\n    // Delete: ADMIN only\r\n    // ============================================================\r\n    match /employees/{employeeId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if isAdmin() || (hasRole('PRODUCTION_SUPERVISOR') && request.resource.data.department == getSupervisorDepartment());\r\n      allow update: if isAdmin() || (hasRole('PRODUCTION_SUPERVISOR') && resource.data.department == getSupervisorDepartment() && request.resource.data.department == resource.data.department);\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // workers - Secondary worker list for target assignment\r\n    // All authenticated users can read; only admins write\r\n    // ============================================================\r\n    match /workers/{workerId} {\r\n      allow read: if isAuthenticated();\r\n      allow create, update, delete: if isAdmin();\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // productionStages - Stage definitions & default targets\r\n    // All authenticated users can read; only admins write\r\n    // ============================================================\r\n    match /productionStages/{stageId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // targetConfigs - Per-worker daily target overrides\r\n    // All authenticated users can read; only admins write\r\n    // ============================================================\r\n    match /targetConfigs/{configId} {\r\n      allow read: if isAuthenticated();\r\n      allow create, update, delete: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // productionEntries - Daily production records\r\n    // All authenticated users can read\r\n    // Create: PRODUCTION_SUPERVISOR or ADMIN\r\n    // Update: ADMIN or PRODUCTION_SUPERVISOR (paymentStatus/paymentId only)\r\n    // Delete: ADMIN only\r\n    // ============================================================\r\n    match /productionEntries/{entryId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);\r\n      allow update: if isAdmin() || (hasRole('PRODUCTION_SUPERVISOR') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentId']));\r\n      allow delete: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // batches - Production batch lifecycle\r\n    // All authenticated users can read\r\n    // Create/Update: ADMIN, PRODUCTION_SUPERVISOR, FINANCIAL_MANAGER, SALES_MANAGER, SALES_STAFF\r\n    // Delete: ADMIN only\r\n    // ============================================================\r\n    match /batches/{batchId} {\r\n      allow read: if isAuthenticated();\r\n      allow create, update: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR', 'FINANCIAL_MANAGER', 'SALES_MANAGER', 'SALES_STAFF']);\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // counters - Sequential counters (e.g. batch numbering)\r\n    // All authenticated users can read\r\n    // Write: PRODUCTION_SUPERVISOR or ADMIN (for batch number generation)\r\n    // ============================================================\r\n    match /counters/{counterId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // payments - Payment records & receipts\r\n    // All authenticated users can read\r\n    // Create: ADMIN or PRODUCTION_SUPERVISOR (via Pay Due flow)\r\n    // No update/delete (immutable once created)\r\n    // ============================================================\r\n    match /payments/{paymentId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if hasAnyRole(['ADMIN', 'PRODUCTION_SUPERVISOR']);\r\n      allow update, delete: if false;\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // stockIns - Stock received into inventory\r\n    // All authenticated users can read\r\n    // Create: ADMIN, STORE_MANAGER, or PRODUCTION_SUPERVISOR\r\n    // Update/Delete: ADMIN only\r\n    // ============================================================\r\n    match /stockIns/{stockInId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if hasAnyRole(['ADMIN', 'STORE_MANAGER', 'PRODUCTION_SUPERVISOR']);\r\n      allow update, delete: if isAdmin();\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // stockOuts - Stock dispatched from inventory\r\n    // All authenticated users can read\r\n    // Create: STORE_MANAGER or ADMIN or PRODUCTION_SUPERVISOR\r\n    // Update/Delete: ADMIN only\r\n    // ============================================================\r\n    match /stockOuts/{stockOutId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if hasAnyRole(['ADMIN', 'STORE_MANAGER', 'PRODUCTION_SUPERVISOR']);\r\n      allow update, delete: if isAdmin();\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // saleTransactions - Sales records\r\n    // All authenticated users can read\r\n    // Create: SALES_STAFF or ADMIN\r\n    // Update/Delete: ADMIN only\r\n    // ============================================================\r\n    match /saleTransactions/{transactionId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if hasAnyRole(['ADMIN', 'SALES_STAFF', 'FINANCIAL_MANAGER', 'SALES_MANAGER']);\r\n      allow update, delete: if isAdmin();\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // salesTargets - Sales target goals (monthly/quarterly/annual)\r\n    // All authenticated users can read\r\n    // Create: SALES_STAFF or ADMIN\r\n    // Update/Delete: ADMIN only\r\n    // ============================================================\r\n    match /salesTargets/{targetId} {\r\n      allow read: if isAuthenticated();\r\n      allow create: if hasAnyRole(['ADMIN', 'SALES_STAFF', 'FINANCIAL_MANAGER', 'SALES_MANAGER']);\r\n      allow update, delete: if isAdmin();\r\n    }\r\n\r\n\r\n    // ============================================================\r\n    // expenses - Business expense records\r\n    // All authenticated users can read\r\n    // Create: FINANCE or ADMIN\r\n    // Update/Delete: ADMIN only\r\n    // ============================================================\r\n    match /accountJournals/{journalId} {\n      allow read: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER', 'SALES_MANAGER', 'SALES_STAFF']);\n      allow create: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER'])\n        && request.resource.data.createdBy == request.auth.uid\n        && request.resource.data.amount is number && request.resource.data.amount > 0\n        && request.resource.data.debitCode is string && request.resource.data.creditCode is string\n        && request.resource.data.debitCode != request.resource.data.creditCode\n        && request.resource.data.date is string && request.resource.data.description is string;\n      allow update: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER'])\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'debitCode', 'creditCode', 'amount', 'description'])\n        && request.resource.data.amount is number && request.resource.data.amount > 0\n        && request.resource.data.debitCode is string && request.resource.data.creditCode is string\n        && request.resource.data.debitCode != request.resource.data.creditCode\n        && request.resource.data.date is string && request.resource.data.description is string;\n      allow delete: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER']);\n    }\n    match /productionCosts/{costId} {\n      allow read: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER', 'SALES_MANAGER', 'SALES_STAFF']);\n      allow create: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER'])\n        && request.resource.data.createdBy == request.auth.uid\n        && request.resource.data.amount is number && request.resource.data.amount > 0\n        && request.resource.data.date is string\n        && request.resource.data.description is string && request.resource.data.description.size() > 0\n        && request.resource.data.settlementCode in ['1000', '1030'];\n      allow update: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER'])\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'description', 'amount', 'settlementCode', 'reference', 'notes'])\n        && request.resource.data.amount is number && request.resource.data.amount > 0\n        && request.resource.data.date is string\n        && request.resource.data.description is string && request.resource.data.description.size() > 0\n        && request.resource.data.settlementCode in ['1000', '1030'];\n      allow delete: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER']);\n    }\n    match /expenses/{expenseId} {\n      allow read: if isAuthenticated();\r\n      allow create: if hasAnyRole(['ADMIN', 'FINANCE', 'FINANCIAL_MANAGER']);\r\n      allow update, delete: if isAdmin();\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-01T20:18:16.269695Z","metadata":{"services":["cloud.firestore"]}}
